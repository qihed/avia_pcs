# Окружение docker: PostgreSQL в контейнере (compose-проект avia-docker, свой том с данными).
# Порт 5441 выбран, чтобы не конфликтовать с PostgreSQL окружения local (5432).
# Личные правки кладите в env/docker.local.env — этот файл git игнорирует.
DB_HOST=localhost
DB_PORT=5441
DB_CONTAINER_PORT=5432
DB_NAME=avia_booking
DB_USER=avia_app
DB_PASSWORD=avia_app_password
TIME_ZONE=Europe/Moscow
