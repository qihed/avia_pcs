# Настройки backend (КР3). Скопируйте в .env: cp .env.example .env и задайте свои значения.
# JWT-секрет:      openssl rand -base64 48
# Пароль БД/админа: любой случайный (openssl rand -hex 16)
POSTGRES_DB=avia_booking
POSTGRES_USER=avia_app
POSTGRES_PASSWORD=change_me

JWT_SECRET_BASE64=change_me_base64_secret_at_least_32_bytes
JWT_ISSUER=avia-backend
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=change_me_temporary_admin_password

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
PERMANENT_DELETE_ENABLED=false
APP_PORT=8080
POSTGRES_PORT=55432
