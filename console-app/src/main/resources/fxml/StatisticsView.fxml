<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="view" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="view-header">
        <Label text="Статистика" styleClass="view-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Обновить" styleClass="btn-secondary" onAction="#refresh"/>
    </HBox>
    <VBox spacing="16" styleClass="view-body" VBox.vgrow="ALWAYS">
        <GridPane hgap="14" vgap="14">
            <VBox styleClass="card" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="260">
                <Label text="Всего пассажиров" styleClass="section-title"/><Label fx:id="passengersValue" text="0" styleClass="card-title"/>
            </VBox>
            <VBox styleClass="card" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="260">
                <Label text="Всего рейсов" styleClass="section-title"/><Label fx:id="flightsValue" text="0" styleClass="card-title"/>
            </VBox>
            <VBox styleClass="card" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0" prefWidth="260">
                <Label text="Всего бронирований" styleClass="section-title"/><Label fx:id="bookingsValue" text="0" styleClass="card-title"/>
            </VBox>
            <VBox styleClass="card" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1" prefWidth="260">
                <Label text="Активных броней" styleClass="section-title"/><Label fx:id="activeValue" text="0" styleClass="card-title"/>
            </VBox>
            <VBox styleClass="card" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="260">
                <Label text="Завершённых броней" styleClass="section-title"/><Label fx:id="completedValue" text="0" styleClass="card-title"/>
            </VBox>
            <VBox styleClass="card" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1" prefWidth="260">
                <Label text="Отменённых броней" styleClass="section-title"/><Label fx:id="cancelledValue" text="0" styleClass="card-title"/>
            </VBox>
        </GridPane>
        <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
            <Label text="Бронирования по статусам" styleClass="card-title"/>
            <BarChart fx:id="statusChart" legendVisible="false" animated="false" VBox.vgrow="ALWAYS">
                <xAxis><CategoryAxis label="Статус"/></xAxis>
                <yAxis><NumberAxis label="Количество" forceZeroInRange="true" tickUnit="1"/></yAxis>
            </BarChart>
        </VBox>
    </VBox>
</VBox>
