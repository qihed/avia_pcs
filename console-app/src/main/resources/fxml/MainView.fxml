<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Каркас окна: меню слева, экран по центру, подключение к БД снизу. Новые экраны — новые кнопки в меню. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.avia.fx.controller.MainController" styleClass="main-pane">
    <left>
        <VBox styleClass="sidebar" prefWidth="200" minWidth="200" spacing="28">
            <VBox spacing="2">
                <Label text="АВИАБРОНИРОВАНИЕ" styleClass="brand-title"/>
                <Label text="Система бронирования билетов" styleClass="brand-subtitle" wrapText="true"/>
            </VBox>
            <Button text="Бронирования" styleClass="nav-button" maxWidth="Infinity" onAction="#onBookings"/>
            <Button text="Рейсы" styleClass="nav-link" maxWidth="Infinity" onAction="#onFlights"/>
            <Button text="Статистика" styleClass="nav-link" maxWidth="Infinity" onAction="#onStatistics"/>
            <!-- Временно, пока нет экранов «Пассажиры» и «Рейсы»: формы открываются прямо из меню. -->
            <VBox spacing="4">
                <Label text="ФОРМЫ" styleClass="sidebar-caption"/>
                <Button text="Новый пассажир" styleClass="nav-link" maxWidth="Infinity" onAction="#onNewPassenger"/>
                <Button text="Изменить пассажира" styleClass="nav-link" maxWidth="Infinity" onAction="#onEditPassenger"/>
                <Button text="Новый рейс" styleClass="nav-link" maxWidth="Infinity" onAction="#onNewFlight"/>
                <Button text="Изменить рейс" styleClass="nav-link" maxWidth="Infinity" onAction="#onEditFlight"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="statusMessage" styleClass="status-message"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="connectionBadge" styleClass="connection-badge"/>
        </HBox>
    </bottom>
</BorderPane>
