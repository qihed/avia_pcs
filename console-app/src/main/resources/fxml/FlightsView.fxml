<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="view" spacing="10">
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="view-header">
        <Label text="Рейсы" styleClass="view-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Обновить" styleClass="btn-secondary" onAction="#refresh"/>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS" styleClass="view-body">
        <VBox spacing="6">
            <TableView fx:id="flightsTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
                <placeholder><Label text="Рейсы не найдены"/></placeholder>
                <columns>
                    <TableColumn fx:id="numberColumn" text="Рейс"/>
                    <TableColumn fx:id="airlineColumn" text="Авиакомпания"/>
                    <TableColumn fx:id="routeColumn" text="Маршрут"/>
                    <TableColumn fx:id="departureColumn" text="Вылет"/>
                    <TableColumn fx:id="arrivalColumn" text="Прилёт"/>
                    <TableColumn fx:id="seatsColumn" text="Мест"/>
                    <TableColumn fx:id="priceColumn" text="Базовый тариф, ₽"/>
                    <TableColumn fx:id="flightStatusColumn" text="Статус"/>
                </columns>
            </TableView>
            <Label fx:id="flightsCountLabel" styleClass="count-label"/>
        </VBox>
        <VBox spacing="6">
            <Label fx:id="selectedFlightLabel" text="Выберите рейс в верхней таблице" styleClass="card-title"/>
            <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
                <placeholder><Label text="У выбранного рейса нет бронирований"/></placeholder>
                <columns>
                    <TableColumn fx:id="bookingIdColumn" text="№"/>
                    <TableColumn fx:id="passengerColumn" text="Пассажир"/>
                    <TableColumn fx:id="seatColumn" text="Место"/>
                    <TableColumn fx:id="fareColumn" text="Класс"/>
                    <TableColumn fx:id="bookingPriceColumn" text="Цена, ₽"/>
                    <TableColumn fx:id="bookingStatusColumn" text="Статус"/>
                </columns>
            </TableView>
            <Label fx:id="bookingsCountLabel" text="Бронирований: 0" styleClass="count-label"/>
        </VBox>
    </SplitPane>
</VBox>
