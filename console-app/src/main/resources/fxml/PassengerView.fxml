<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Экран «Пассажиры»: кнопки, поиск и фильтр сверху, таблица пассажиров, под ней брони выбранного пассажира.
     Контроллер задаётся в MainApp (ему передаются сервисы), поэтому fx:controller здесь нет. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="view">
    <top>
        <VBox styleClass="view-header" spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Пассажиры" styleClass="view-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Добавить" styleClass="btn-primary" onAction="#onAdd"/>
                <Button fx:id="editButton" text="Изменить" styleClass="btn-secondary" onAction="#onEdit"/>
                <Button fx:id="deleteButton" text="Удалить" styleClass="btn-danger" onAction="#onDelete"/>
                <Button text="Обновить" styleClass="btn-secondary" onAction="#onRefresh"/>
            </HBox>
            <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT" styleClass="filter-bar">
                <TextField fx:id="searchField" prefWidth="380"
                           promptText="Поиск: ФИО, номер документа, e-mail, телефон, №"/>
                <ComboBox fx:id="documentTypeCombo" prefWidth="220" promptText="Все документы"/>
                <Button text="Сбросить" styleClass="btn-link" onAction="#onReset"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.55" styleClass="view-split">
            <padding>
                <Insets left="24" right="24" bottom="12"/>
            </padding>
            <VBox spacing="8">
                <TableView fx:id="table" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Нет пассажиров, подходящих под условия"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="idColumn" text="№" minWidth="32" prefWidth="40"/>
                        <TableColumn fx:id="nameColumn" text="ФИО" minWidth="140" prefWidth="220"/>
                        <TableColumn fx:id="birthDateColumn" text="Дата рождения" minWidth="100" prefWidth="110"/>
                        <TableColumn fx:id="documentColumn" text="Документ" minWidth="140" prefWidth="230"/>
                        <TableColumn fx:id="emailColumn" text="E-mail" minWidth="120" prefWidth="180"/>
                        <TableColumn fx:id="phoneColumn" text="Телефон" minWidth="100" prefWidth="120"/>
                        <TableColumn fx:id="bookingsColumn" text="Броней" minWidth="56" prefWidth="64"/>
                    </columns>
                </TableView>
                <Label fx:id="countLabel" styleClass="count-label"/>
            </VBox>
            <VBox spacing="8" styleClass="split-bottom">
                <HBox alignment="BASELINE_LEFT" spacing="12">
                    <Label fx:id="bookingsTitle" styleClass="card-title"/>
                    <Label fx:id="bookingsSummary" styleClass="count-label"/>
                </HBox>
                <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label fx:id="bookingsPlaceholder" styleClass="placeholder-text"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="bookingIdColumn" text="№" minWidth="32" prefWidth="40"/>
                        <TableColumn fx:id="bookingFlightColumn" text="Рейс" minWidth="56" prefWidth="70"/>
                        <TableColumn fx:id="bookingRouteColumn" text="Маршрут" minWidth="80" prefWidth="102"/>
                        <TableColumn fx:id="bookingDepartureColumn" text="Вылет" minWidth="112" prefWidth="132"/>
                        <TableColumn fx:id="bookingSeatColumn" text="Место" minWidth="42" prefWidth="50"/>
                        <TableColumn fx:id="bookingFareClassColumn" text="Класс" minWidth="66" prefWidth="78"/>
                        <TableColumn fx:id="bookingPriceColumn" text="Цена, ₽" minWidth="72" prefWidth="90"/>
                        <TableColumn fx:id="bookingStatusColumn" text="Статус" minWidth="84" prefWidth="110"/>
                    </columns>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
