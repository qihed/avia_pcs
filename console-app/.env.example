# Настройки запуска через Docker (docker-compose.yml).
# Скопируйте файл в .env и задайте свой пароль: cp .env.example .env
# Имя базы, пользователь и пароль применяются только при создании базы,
# после их изменения выполните docker compose down -v.

DB_NAME=avia_booking
DB_USER=avia_app
DB_PASSWORD=change_me

# Порт базы на этом компьютере: для psql, DBeaver или запуска из IDE
DB_PORT=5441
# Порт PostgreSQL внутри Docker
DB_CONTAINER_PORT=5432

# Часовой пояс базы и приложения
TIME_ZONE=Europe/Moscow
