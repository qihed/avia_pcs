# Шаблон локальных параметров АВИА-БРОНЬ. Файл .env не коммитится.
# Создайте .env командой ./init-env.sh или .\init-env.ps1 (пароль будет сгенерирован)
# либо скопируйте этот файл в .env и замените REPLACE_ME.
# DB_URL, DB_USER и DB_PASSWORD по умолчанию собираются из POSTGRES_*.
POSTGRES_DB=avia_booking
POSTGRES_USER=avia_app
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_PORT=5432
DEMO_DATA=true
EXPORT_DIR=exports
APP_TIME_ZONE=Europe/Moscow
